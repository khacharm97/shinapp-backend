datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MASTER
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  googleId  String?  @unique
  password  String?
  roles     Role[]   @default([USER])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  avatarUrl  String?
  verifiedAt DateTime?
  isBlocked  Boolean  @default(false)

  userInfo UserInfo?
  portfolios Portfolio[]

  @@unique([email, phone]) // Allows efficient querying for either
}

model UserInfo {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  regionId String?
  cityId   String?
  skills   String[] @default([])

  largeScale   Boolean @default(false)
  urgentOrders Boolean @default(false)
  onlinePay    Boolean @default(false)
  buyMaterial  Boolean @default(false)
  nightShift   Boolean @default(false)
  topRated     Boolean @default(false)
  availableNow Boolean @default(true)

  pricingFormat String?
  priceValue    String?
  about         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  email     String
  firstName String?
  lastName  String?
  notes     String?
  contact   Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(uuid())
  key       String   @unique
  nameEn    String
  nameAm    String
  nameRu    String
  icon      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  imageUrls   String[] @default([])
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
