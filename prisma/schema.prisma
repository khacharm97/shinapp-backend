datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MASTER
  COMPANY
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  googleId  String?  @unique
  password  String?
  roles     Role[]   @default([USER])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  avatarUrl  String?
  verifiedAt DateTime?
  isBlocked  Boolean  @default(false)
  // Opt-out for the "you have unread chat messages" email reminder.
  emailOnUnreadMessages Boolean @default(true)

  userInfo UserInfo?
  portfolios Portfolio[]
  ownedBrigades Brigade[] @relation("BrigadeOwner")
  brigadeMemberships BrigadeMember[] @relation("BrigadeMembership")
  notifications Notification[] @relation("UserNotifications")
  announcements Announcement[] @relation("CompanyAnnouncements")

  clientOrders Order[] @relation("ClientOrders")
  masterOrders Order[] @relation("MasterOrders")
  orderAssignments OrderAssignment[] @relation("OrderAssignments")
  busyPeriods  BusyPeriod[] @relation("MasterBusyPeriods")
  techniques   Technique[] @relation("TechniqueOwner")
  writtenReviews Review[] @relation("WrittenReviews")
  receivedReviews Review[] @relation("ReceivedReviews")

  chatParticipations ConversationParticipant[]
  sentMessages       Message[] @relation("MessageSender")

  @@unique([email, phone]) // Allows efficient querying for either
}

model UserInfo {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  regionId String?
  cityId   String?
  skills   String[] @default([])

  largeScale   Boolean @default(false)
  urgentOrders Boolean @default(false)
  onlinePay    Boolean @default(false)
  buyMaterial  Boolean @default(false)
  nightShift   Boolean @default(false)
  multipleJobs Boolean @default(false)
  topRated     Boolean @default(false)
  availableNow Boolean @default(true)

  pricingFormat String?
  priceValue    String?
  about         String?

  // Company specific fields
  website         String?
  socialFacebook  String?
  socialInstagram String?
  socialTiktok    String?
  workingPlaces   String[] @default([])
  itn             String?
  workersCount    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  email     String
  firstName String?
  lastName  String?
  notes     String?
  contact   Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(uuid())
  key       String   @unique
  nameEn    String
  nameAm    String
  nameRu    String
  nameFa    String   @default("")
  icon      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  imageUrls   String[] @default([])
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Brigade {
  id          String   @id @default(uuid())
  name        String
  about       String?
  ownerId     String
  owner       User     @relation("BrigadeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  members     BrigadeMember[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrigadeMember {
  id          String   @id @default(uuid())
  brigadeId   String
  brigade     Brigade  @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("BrigadeMembership", fields: [userId], references: [id], onDelete: Cascade)
  status      InviteStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brigadeId, userId])
}

enum NotificationType {
  BRIGADE_INVITE
  SYSTEM
  ORDER_INVITE
  ORDER_UPDATE
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_OVERDUE
  ORDER_ASSIGNED
  ANNOUNCEMENT
  MESSAGE
}

enum ConversationType {
  USER_MASTER
  MASTER_COMPANY
  SUPPORT
}

model Conversation {
  id             String           @id @default(uuid())
  type           ConversationType
  // Optional context this conversation is anchored to.
  announcementId String?
  orderId        String?

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([announcementId])
  @@index([orderId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  // Last time an unread-messages email reminder was sent to this participant.
  // Reset semantics: we only re-email once lastReadAt moves past lastEmailedAt
  // (i.e. the user caught up and then fell behind again).
  lastEmailedAt  DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachments    String[]     @default([])

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnnouncementStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Announcement {
  id          String   @id @default(uuid())
  companyId   String
  company     User     @relation("CompanyAnnouncements", fields: [companyId], references: [id], onDelete: Cascade)
  sphere      String
  title       String
  description String
  urgent      Boolean  @default(false)
  status      AnnouncementStatus @default(PUBLISHED)
  startDate   DateTime
  endDate     DateTime
  imageUrls   String[] @default([])
  viewsCount  Int      @default(0)
  views       AnnouncementView[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per de-duplicated view. `viewerKey` is `user:<userId>` for a
// logged-in viewer or `ip:<hash>` for an anonymous one; `viewDate` is the
// view's calendar day truncated to UTC midnight. The unique constraint is
// what makes a repeat view within the same day a no-op instead of a new row,
// so `Announcement.viewsCount` stays a trustworthy denormalized total.
model AnnouncementView {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  viewerKey      String
  viewDate       DateTime
  createdAt      DateTime     @default(now())

  @@unique([announcementId, viewerKey, viewDate])
  @@index([announcementId])
}


enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
  COMPLETION_REQUESTED
}

model Order {
  id              String      @id @default(uuid())
  clientId        String
  client          User        @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  masterId        String
  master          User        @relation("MasterOrders", fields: [masterId], references: [id], onDelete: Cascade)
  initiatorId     String

  // Set when this order was placed against a Brigade rather than an
  // individual master. `masterId` still holds the brigade owner's id - the
  // owner is who actually accepted the contract - and once accepted, the
  // owner staffs it by creating OrderAssignment rows for specific members.
  brigadeId       String?
  brigade         Brigade?    @relation(fields: [brigadeId], references: [id], onDelete: SetNull)
  assignments     OrderAssignment[]

  // Set when this order is booking a specific Technique rather than a
  // general master contract. `masterId` still holds the technique owner's
  // id, so all existing master-order logic (accept/reject/notifications/
  // reviews) keeps working unchanged for technique bookings.
  techniqueId     String?
  technique       Technique?  @relation(fields: [techniqueId], references: [id], onDelete: SetNull)

  description     String
  imageUrl        String?
  startDate       DateTime
  endDate         DateTime
  paymentMethod   String
  price           Float?

  address         String?
  latitude        Float?
  longitude       Float?

  status          OrderStatus @default(PENDING)
  privacyAccepted Boolean

  // Set once the master has been notified that this order's endDate passed
  // while it was still not COMPLETED, so the overdue sweep notifies each
  // order only once instead of on every run.
  overdueNotifiedAt DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reviews         Review[]

  @@index([techniqueId])
  @@index([brigadeId])
}

// A brigade owner staffing a brigade order: which member(s) will actually do
// the work. `Order.masterId` stays the owner throughout (the owner is who
// accepted the contract), so this is purely a roster/scheduling layer -
// assigned members' calendars (getBusyDatesForMaster) block out the order's
// dates the same way an owner's own order would.
model OrderAssignment {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  memberId   String
  member     User     @relation("OrderAssignments", fields: [memberId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([orderId, memberId])
  @@index([memberId])
}

// A period a master/company manually marks themselves unavailable for
// (vacation, a job outside the platform, etc.), separate from - and on top
// of - the busy periods derived from their accepted orders. Only rows here
// can be removed by the master; order-derived busy dates aren't stored as
// BusyPeriod rows at all.
model BusyPeriod {
  id        String   @id @default(uuid())
  masterId  String
  master    User     @relation("MasterBusyPeriods", fields: [masterId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([masterId])
}

enum TechniquePriceType {
  HOURLY
  FIXED
}

model Technique {
  id          String             @id @default(uuid())
  ownerId     String
  owner       User               @relation("TechniqueOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  imageUrls   String[]           @default([])
  priceType   TechniquePriceType
  price       Float

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  orders      Order[]

  @@index([ownerId])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("WrittenReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReceivedReviews", fields: [targetId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, authorId])
}

