datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MASTER
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  googleId  String?  @unique
  password  String?
  roles     Role[]   @default([USER])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  avatarUrl  String?
  verifiedAt DateTime?
  isBlocked  Boolean  @default(false)

  userInfo UserInfo?
  portfolios Portfolio[]
  ownedBrigades Brigade[] @relation("BrigadeOwner")
  brigadeMemberships BrigadeMember[] @relation("BrigadeMembership")
  notifications Notification[] @relation("UserNotifications")

  @@unique([email, phone]) // Allows efficient querying for either
}

model UserInfo {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  regionId String?
  cityId   String?
  skills   String[] @default([])

  largeScale   Boolean @default(false)
  urgentOrders Boolean @default(false)
  onlinePay    Boolean @default(false)
  buyMaterial  Boolean @default(false)
  nightShift   Boolean @default(false)
  topRated     Boolean @default(false)
  availableNow Boolean @default(true)

  pricingFormat String?
  priceValue    String?
  about         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  email     String
  firstName String?
  lastName  String?
  notes     String?
  contact   Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(uuid())
  key       String   @unique
  nameEn    String
  nameAm    String
  nameRu    String
  nameFa    String   @default("")
  icon      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  imageUrls   String[] @default([])
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Brigade {
  id          String   @id @default(uuid())
  name        String
  ownerId     String
  owner       User     @relation("BrigadeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  members     BrigadeMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrigadeMember {
  id          String   @id @default(uuid())
  brigadeId   String
  brigade     Brigade  @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("BrigadeMembership", fields: [userId], references: [id], onDelete: Cascade)
  status      InviteStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brigadeId, userId])
}

enum NotificationType {
  BRIGADE_INVITE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
